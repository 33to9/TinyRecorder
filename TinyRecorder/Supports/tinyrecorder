#!/bin/bash
# tinyrecorder: control TinyRecorder from the command line (and from AI agents).
#
# A thin wrapper around the app's AppleScript commands (README › Automation). It ships inside
# TinyRecorder.app/Contents/Resources; the Homebrew cask links it into the PATH. To link it
# yourself:
#   ln -s /Applications/TinyRecorder.app/Contents/Resources/tinyrecorder /usr/local/bin/tinyrecorder
#
# Written for the bash 3.2 that comes with macOS.

JSON=0

usage() {
  cat <<'EOF'
tinyrecorder: control TinyRecorder from the command line

Usage:
  tinyrecorder doctor                          Check that everything needed is in place (permissions, folder)
  tinyrecorder list displays|windows|apps      List what can be recorded (window IDs, display numbers)
  tinyrecorder record screen [NUMBER]          Record a display (1 = main). No number: open the picker
  tinyrecorder record window TITLE [--app APP] Record the window with this exact title
  tinyrecorder record window --id ID           Record the window with this ID (from list windows)
  tinyrecorder record app NAME                 Record all windows of an app
  tinyrecorder record area X,Y,W,H [--display N]
                                               Record this area (points from the display's top-left)
  tinyrecorder record area                     Drag the area to record with the mouse
  tinyrecorder record audio [--mic|--no-mic]   Record system audio, with or without the microphone
  tinyrecorder stop [--no-wait]                Stop, wait until the file is saved, print its path
  tinyrecorder pause | resume                  Pause / resume the recording
  tinyrecorder discard                         Stop and move the recording to the Trash
  tinyrecorder status                          Print the state, kind and seconds recorded
  tinyrecorder screenshot [TARGET] [--output PATH]
                                               Save a PNG and print its path. TARGET: screen [NUMBER],
                                               window TITLE [--app APP], window --id ID, or
                                               area X,Y,W,H [--display N]. Default: display 1.
                                               Needs macOS 14 or later
  tinyrecorder frames FILE [OPTIONS]           Save still images from a recording (see below)
  tinyrecorder config [OPTIONS]                Change recording settings (see below)
  tinyrecorder config --show                   Print the current settings
  tinyrecorder version                         Print the TinyRecorder version
  tinyrecorder help                            Show this help

Record options:
  --output PATH        Save the recording as PATH. The extension of the current format is added
                       (.mp4 or .mov; audio: .m4a, .mp3, .flac, .ogg, or .qma with the microphone);
                       if PATH has one, it must match. The folder must exist; existing files are
                       never replaced.
  --quiet, -q          Same as --no-countdown --no-preview: nothing shows up on screen that
                       could get in the way of the recording or of the next screenshot.
  --no-countdown       Start right away, whatever Delay Before Recording is set to.
  --countdown SECONDS  Count down this long first, instead of the setting.
  --no-preview         No preview thumbnail, trimmer or notification after saving.
  --duration SECONDS   Record this long, then stop and print the saved file's path.
                       Ctrl-C stops early and still saves.
  --no-wait            Return as soon as the command is sent. By default, record waits until
                       the recording has started (after the countdown, if one is set).

Frames options (default: 8 frames spread over the recording, saved as PNGs in a
"NAME frames" folder next to it; prints their paths):
  --every SECONDS      One frame every SECONDS (e.g. 2 or 0.5), at most 200
  --count N            N frames, evenly spread (1 to 200)
  --sheet              One contact sheet with all frames and their times (12 by default)
  --width PIXELS       Largest width of each frame (1280; 480 on a sheet)
  --output FOLDER      Save the images in this folder

Config options:
  --countdown N        Delay Before Recording, in seconds (0 to 99)
  --preview on|off     Show the preview thumbnail after saving
  --fps N              10, 15, 24, 30, 60, 90, 120, 144 or 240
  --quality N          1 = low, 2 = medium, 3 = high
  --format mp4|mov     Video file format
  --codec h264|h265    Video codec
  --hires on|off       Record at Retina resolution
  --cursor on|off      Record the mouse pointer
  --sound on|off       Record system / app sound
  --mic on|off         Record the microphone
  --mic-device NAME    Input device name, or "default"
  --hdr on|off         Record in HDR (macOS 15 and later)
  --folder PATH        Folder recordings are saved to (must exist)

Global options:
  --json               Print results as JSON (one object per command)

Exit status: 0 on success, 1 if TinyRecorder reports an error, 2 for a usage error.
Errors are printed to stderr.

The first time, macOS asks whether your terminal may control TinyRecorder; click OK.
You can change this in System Settings › Privacy & Security › Automation.

Examples:
  tinyrecorder record screen 1 --duration 10       # 10 s of the main display, prints the file
  tinyrecorder list windows --app Safari           # IDs and titles of Safari's windows
  tinyrecorder record window --id 1234 --duration 5 --output ~/Desktop/demo.mp4
  tinyrecorder record area 0,0,1280,720 --duration 5 --quiet
  tinyrecorder frames ~/Desktop/demo.mp4 --sheet    # one image to check what was recorded
  tinyrecorder screenshot window --id 1234 --output shot.png
  tinyrecorder record window "Untitled" --app TextEdit && sleep 5 && tinyrecorder stop
  tinyrecorder status --json
EOF
}

die() { echo "tinyrecorder: $*" >&2; exit 1; }
usage_error() { echo "tinyrecorder: $*" >&2; echo "Run 'tinyrecorder help' for usage." >&2; exit 2; }

# JSON string literal for $1.
json_str() {
  local s=$1
  s=${s//\\/\\\\}; s=${s//\"/\\\"}
  s=${s//$'\n'/\\n}; s=${s//$'\r'/\\r}; s=${s//$'\t'/\\t}
  printf '"%s"' "$s"
}

# Runs an AppleScript, passing the remaining arguments as argv (never pasted into the
# script, so titles and paths can contain any character). Prints the script's result.
# On failure prints TinyRecorder's error message and exits 1.
run_script() {
  local script=$1; shift
  local errfile out msg
  errfile=$(mktemp "${TMPDIR:-/tmp}/tinyrecorder.XXXXXX") || die "can't create a temporary file"
  if out=$(printf '%s\n' "$script" | osascript - "$@" 2>"$errfile"); then
    rm -f "$errfile"
    printf '%s' "$out"
    return 0
  fi
  msg=$(cat "$errfile"); rm -f "$errfile"
  case $msg in
    *-1743*) die "not allowed to control TinyRecorder. Allow your terminal in System Settings › Privacy & Security › Automation." ;;
    *-1728*|*-1708*) die "this TinyRecorder version doesn't support this command. Update the app (Check for Updates…)." ;;
  esac
  # "execution error: TinyRecorder got an error: No such window! (-10000)" → "No such window!"
  msg=${msg#*execution error: }; msg=${msg#*got an error: }; msg=${msg% (-[0-9]*)}
  die "$msg"
}

app_running() {
  [ "$(osascript -e 'application id "com.33to9.TinyRecorder" is running' 2>/dev/null)" = "true" ]
}

# Prints "state<TAB>kind<TAB>elapsed-in-tenths" ("not-running" if the app isn't open).
read_status() {
  if ! app_running; then printf 'not-running\t\t'; return; fi
  run_script 'on run argv
	tell application id "com.33to9.TinyRecorder" to set s to recording status
	using terms from application id "com.33to9.TinyRecorder"
		set k to ""
		set e to ""
		try
			set k to recording kind of s
		end try
		try
			set e to round ((elapsed of s) * 10)
		end try
		return (state of s) & tab & k & tab & e
	end using terms from
end run'
}

current_state() {
  local line
  line=$(read_status) || exit 1
  printf '%s' "$line" | cut -f1
}

cmd_status() {
  local line state kind tenths elapsed=""
  line=$(read_status) || exit 1
  state=$(printf '%s' "$line" | cut -f1)
  kind=$(printf '%s' "$line" | cut -f2)
  tenths=$(printf '%s' "$line" | cut -f3)
  [ -n "$tenths" ] && elapsed="$((tenths / 10)).$((tenths % 10))"
  if [ $JSON = 1 ]; then
    printf '{"state":%s' "$(json_str "$state")"
    [ -n "$kind" ] && printf ',"kind":%s' "$(json_str "$kind")"
    [ -n "$elapsed" ] && printf ',"elapsed":%s' "$elapsed"
    printf '}\n'
  else
    echo "state: $state"
    [ -n "$kind" ] && echo "kind: $kind"
    [ -n "$elapsed" ] && echo "elapsed: $elapsed"
  fi
  return 0
}

# Stops and waits for the file; prints its path.
stop_and_save() {
  local file
  file=$(run_script 'on run argv
	with timeout of 3600 seconds
		tell application id "com.33to9.TinyRecorder" to stop recording with waiting until saved
	end timeout
end run') || exit 1
  # No file: the stop cancelled a countdown, so nothing was recorded.
  if [ -z "$file" ]; then
    if [ $JSON = 1 ]; then echo '{"state":"cancelled"}'; else echo "Cancelled the countdown; nothing was recorded." >&2; fi
    return 0
  fi
  if [ $JSON = 1 ]; then printf '{"file":%s}\n' "$(json_str "$file")"; else echo "$file"; fi
}

cmd_stop() {
  local wait=1
  while [ $# -gt 0 ]; do
    case $1 in
      --no-wait) wait=0 ;;
      *) usage_error "unknown option for stop: $1" ;;
    esac
    shift
  done
  if [ $wait = 1 ]; then
    stop_and_save
  else
    run_script 'tell application id "com.33to9.TinyRecorder" to stop recording' >/dev/null || exit 1
    [ $JSON = 1 ] && echo '{"state":"stopping"}'
  fi
  return 0
}

simple_command() { # simple_command <applescript command>
  run_script "tell application id \"com.33to9.TinyRecorder\" to $1" >/dev/null || exit 1
  [ $JSON = 1 ] && echo '{"ok":true}'
  return 0
}

# Waits until the recording has started. $1 = timeout in seconds; $2 = 1 if the user is
# choosing what to record (the app stays idle meanwhile), 0 if it should start by itself.
wait_for_start() {
  local limit=$(( $1 * 2 )) i=0 state
  while [ $i -lt $limit ]; do
    state=$(current_state) || exit 1
    case $state in
      recording|paused) return 0 ;;
      idle) [ "$2" = 0 ] && [ $i -ge 4 ] && die "the recording didn't start (it was cancelled, or the window or display went away)" ;;
    esac
    sleep 0.5
    i=$((i + 1))
  done
  die "the recording didn't start within $1 seconds"
}

# Collects AppleScript parameters whose values travel in argv (never pasted into the script):
# add_param NAME VALUE [int]. The caller resets P and A first.
add_param() {
  A+=("$2")
  if [ "${3:-}" = int ]; then P="$P $1 ((item ${#A[@]} of argv) as integer)"; else P="$P $1 (item ${#A[@]} of argv)"; fi
}

# Absolute path for a path given on the command line (TinyRecorder doesn't know our directory).
abs_path() {
  case $1 in /*|~*) printf '%s' "$1" ;; *) printf '%s/%s' "$PWD" "$1" ;; esac
}

check_number() { # check_number OPTION VALUE
  case $2 in ''|*[!0-9]*) usage_error "$1 must be a number" ;; esac
}

check_rect() {
  case $1 in *[!0-9,\ ]*|'') usage_error "the area must be X,Y,WIDTH,HEIGHT in points, e.g. 100,100,1280,720" ;; esac
}

cmd_record() {
  local what=${1:-}; [ -n "$what" ] || usage_error "record what? screen, window, app, area or audio"
  shift
  local target="" app="" mic="" duration="" wait=1 output="" id="" display="" countdown="" preview=""
  while [ $# -gt 0 ]; do
    case $1 in
      --app) [ $# -ge 2 ] || usage_error "--app needs a name"; app=$2; shift ;;
      --id) [ $# -ge 2 ] || usage_error "--id needs a window ID"; id=$2; shift ;;
      --display) [ $# -ge 2 ] || usage_error "--display needs a number"; display=$2; shift ;;
      --output|-o) [ $# -ge 2 ] || usage_error "--output needs a path"; output=$2; shift ;;
      --countdown) [ $# -ge 2 ] || usage_error "--countdown needs a number of seconds"; countdown=$2; shift ;;
      --no-countdown) countdown=0 ;;
      --no-preview) preview=false ;;
      --quiet|-q) countdown=0; preview=false ;;
      --mic) mic=true ;;
      --no-mic) mic=false ;;
      --duration) [ $# -ge 2 ] || usage_error "--duration needs a number of seconds"; duration=$2; shift ;;
      --no-wait) wait=0 ;;
      -*) usage_error "unknown option for record: $1" ;;
      *) [ -z "$target" ] || usage_error "unexpected argument: $1"; target=$1 ;;
    esac
    shift
  done
  if [ -n "$duration" ]; then
    case $duration in ''|*[!0-9]*|0) usage_error "--duration must be a whole number of seconds (1 or more)" ;; esac
    [ $wait = 1 ] || usage_error "--duration can't be combined with --no-wait"
  fi
  [ -z "$id" ] || check_number --id "$id"
  [ -z "$display" ] || check_number --display "$display"
  [ -z "$countdown" ] || check_number --countdown "$countdown"
  [ "$what" = window ] || [ -z "$app$id" ] || usage_error "--app and --id only go with record window"
  [ "$what" = area ] || [ -z "$display" ] || usage_error "--display only goes with record area; use 'record screen NUMBER' for a whole display"
  [ "$what" = audio ] || [ -z "$mic" ] || usage_error "--mic / --no-mic only go with record audio; use 'config --mic on' for video"

  P=""; A=()
  local command interactive=0
  case $what in
    screen)
      command="record screen"
      if [ -n "$target" ]; then
        case $target in *[!0-9]*) usage_error "the screen number must be a number (1 = main display)" ;; esac
        add_param numbered "$target" int
      else
        interactive=1
      fi ;;
    window)
      command="record window"
      if [ -n "$id" ]; then
        [ -z "$target$app" ] || usage_error "give a window ID or a title, not both"
        add_param "identified by" "$id" int
      elif [ -n "$target" ]; then
        add_param titled "$target"
        [ -z "$app" ] || add_param "in application" "$app"
      else
        [ -z "$app" ] || usage_error "--app needs a window title too"
        interactive=1
      fi ;;
    app|application)
      command="record application"
      if [ -n "$target" ]; then add_param named "$target"; else interactive=1; fi ;;
    area)
      command="record screen area"
      if [ -n "$target" ]; then
        check_rect "$target"
        add_param rectangle "$target"
        [ -z "$display" ] || add_param "display number" "$display" int
      else
        [ -z "$display" ] || usage_error "--display needs the area too: record area X,Y,WIDTH,HEIGHT --display N"
        interactive=1
      fi ;;
    audio)
      command="record system audio"
      [ -z "$target" ] || usage_error "record audio takes no argument"
      [ -z "$mic" ] || P="$P microphone $mic" ;;
    *) usage_error "can't record \"$what\"; use screen, window, app, area or audio" ;;
  esac
  if [ -n "$output$countdown$preview" ] && [ $interactive = 1 ]; then
    usage_error "--output, --countdown, --no-countdown, --no-preview and --quiet need a target given on the command line (a number, title, name or area), not the picker"
  fi
  [ -z "$output" ] || add_param "saving to" "$(abs_path "$output")"
  # Audio recordings have no countdown.
  [ -z "$countdown" ] || [ "$what" = audio ] || add_param countdown "$countdown" int
  [ -z "$preview" ] || P="$P showing preview false"

  # Lets TinyRecorder's usage statistics tell this tool apart from other scripts.
  run_script "on run argv
	tell application id \"com.33to9.TinyRecorder\" to $command$P client \"cli\"
end run" ${A[@]+"${A[@]}"} >/dev/null || exit 1

  # A picker or the area selector waits for the user: only wait for them with --duration.
  if [ $wait = 0 ] || { [ $interactive = 1 ] && [ -z "$duration" ]; }; then
    [ $JSON = 1 ] && echo '{"state":"requested"}'
    [ $JSON = 1 ] || { [ $interactive = 1 ] && echo "Choose what to record in TinyRecorder." >&2; }
    return 0
  fi
  if [ $interactive = 1 ]; then wait_for_start 600 1; else wait_for_start 120 0; fi

  if [ -z "$duration" ]; then
    if [ $JSON = 1 ]; then echo '{"state":"recording"}'; else echo "Recording. Run 'tinyrecorder stop' to finish." >&2; fi
    return 0
  fi
  # Record for the given time; Ctrl-C ends early but still saves.
  local stopped_early=0 s=0
  trap 'stopped_early=1' INT TERM
  while [ $s -lt "$duration" ] && [ $stopped_early = 0 ]; do
    sleep 1
    s=$((s + 1))
  done
  trap - INT TERM
  stop_and_save
}

cmd_list() {
  local kind=${1:-}; [ -n "$kind" ] || usage_error "list what? displays, windows or apps"
  shift
  case $kind in
    display|displays|screen|screens) kind=displays ;;
    window|windows) kind=windows ;;
    app|apps|application|applications) kind=apps ;;
    *) usage_error "can't list \"$kind\"; use displays, windows or apps" ;;
  esac
  local app=""
  while [ $# -gt 0 ]; do
    case $1 in
      --app) [ $# -ge 2 ] || usage_error "--app needs a name"; app=$2; shift ;;
      *) usage_error "unknown option for list: $1" ;;
    esac
    shift
  done
  [ "$kind" != displays ] || [ -z "$app" ] || usage_error "--app only goes with list windows or list apps"
  P=""; A=()
  add_param showing "$kind"
  [ -z "$app" ] || add_param "in application" "$app"
  [ $JSON = 0 ] || P="$P json true"
  local out
  out=$(run_script "on run argv
	tell application id \"com.33to9.TinyRecorder\" to list targets$P
end run" "${A[@]}") || exit 1
  if [ $JSON = 1 ]; then
    echo "$out"
  elif [ -z "$out" ]; then
    echo "No $kind found." >&2
  else
    printf '%s\n' "$out" | column -t -s "$(printf '\t')"
  fi
  return 0
}

cmd_screenshot() {
  local what=${1:-screen}
  [ $# -gt 0 ] && shift
  local target="" app="" output="" id="" display=""
  while [ $# -gt 0 ]; do
    case $1 in
      --app) [ $# -ge 2 ] || usage_error "--app needs a name"; app=$2; shift ;;
      --id) [ $# -ge 2 ] || usage_error "--id needs a window ID"; id=$2; shift ;;
      --display) [ $# -ge 2 ] || usage_error "--display needs a number"; display=$2; shift ;;
      --output|-o) [ $# -ge 2 ] || usage_error "--output needs a path"; output=$2; shift ;;
      -*) usage_error "unknown option for screenshot: $1" ;;
      *) [ -z "$target" ] || usage_error "unexpected argument: $1"; target=$1 ;;
    esac
    shift
  done
  [ -z "$id" ] || check_number --id "$id"
  [ -z "$display" ] || check_number --display "$display"
  [ "$what" = window ] || [ -z "$app$id" ] || usage_error "--app and --id only go with screenshot window"
  [ "$what" = area ] || [ -z "$display" ] || usage_error "--display only goes with screenshot area; use 'screenshot screen NUMBER' for a whole display"
  P=""; A=()
  case $what in
    screen|display)
      if [ -n "$target" ]; then check_number "the screen number" "$target"; add_param "display number" "$target" int; fi ;;
    window)
      if [ -n "$id" ]; then
        [ -z "$target$app" ] || usage_error "give a window ID or a title, not both"
        add_param "window identified by" "$id" int
      else
        [ -n "$target" ] || usage_error "screenshot window needs a title or --id (see 'tinyrecorder list windows')"
        add_param "window titled" "$target"
        [ -z "$app" ] || add_param "in application" "$app"
      fi ;;
    area)
      [ -n "$target" ] || usage_error "screenshot area needs X,Y,WIDTH,HEIGHT"
      check_rect "$target"
      add_param rectangle "$target"
      [ -z "$display" ] || add_param "display number" "$display" int ;;
    *) usage_error "can't take a screenshot of \"$what\"; use screen, window or area" ;;
  esac
  [ -z "$output" ] || add_param "saving to" "$(abs_path "$output")"
  local file
  file=$(run_script "on run argv
	tell application id \"com.33to9.TinyRecorder\" to take screenshot$P
end run" ${A[@]+"${A[@]}"}) || exit 1
  if [ $JSON = 1 ]; then printf '{"file":%s}\n' "$(json_str "$file")"; else echo "$file"; fi
}

cmd_config() {
  [ $# -gt 0 ] || usage_error "config needs at least one option, or --show"
  if [ "$1" = --show ]; then
    [ $# = 1 ] || usage_error "--show takes no other options"
    show_settings
    return 0
  fi
  local params="" n=0 args=() v
  bool() {
    case $1 in
      on|true|yes|1) echo true ;;
      off|false|no|0) echo false ;;
      *) usage_error "expected on or off, got \"$1\"" ;;
    esac
  }
  while [ $# -gt 0 ]; do
    [ $# -ge 2 ] || usage_error "$1 needs a value"
    n=$((n + 1))
    case $1 in
      --fps) params="$params fps ((item $n of argv) as integer)"; v=$2 ;;
      --quality) params="$params quality ((item $n of argv) as integer)"; v=$2 ;;
      --hires) params="$params hires ((item $n of argv) is \"true\")"; v=$(bool "$2") || exit 2 ;;
      --cursor) params="$params cursor ((item $n of argv) is \"true\")"; v=$(bool "$2") || exit 2 ;;
      --sound) params="$params sound ((item $n of argv) is \"true\")"; v=$(bool "$2") || exit 2 ;;
      --mic) params="$params microphone ((item $n of argv) is \"true\")"; v=$(bool "$2") || exit 2 ;;
      --hdr) params="$params hdr ((item $n of argv) is \"true\")"; v=$(bool "$2") || exit 2 ;;
      --mic-device) params="$params mic device (item $n of argv)"; v=$2 ;;
      --folder) params="$params save folder (item $n of argv)"; v=$(abs_path "$2") ;;
      --countdown) params="$params countdown ((item $n of argv) as integer)"; v=$2 ;;
      --preview) params="$params show preview ((item $n of argv) is \"true\")"; v=$(bool "$2") || exit 2 ;;
      --format) params="$params file format (item $n of argv)"; v=$2
        case $v in mp4|mov) ;; *) usage_error "--format must be mp4 or mov" ;; esac ;;
      --codec) params="$params video codec (item $n of argv)"; v=$2
        case $v in h264|h265|h.264|h.265|H264|H265|H.264|H.265) ;; *) usage_error "--codec must be h264 or h265" ;; esac ;;
      *) usage_error "unknown config option: $1" ;;
    esac
    case $1 in --fps|--quality|--countdown) case $v in ''|*[!0-9]*) usage_error "$1 must be a number" ;; esac ;; esac
    args+=("$v")
    shift 2
  done
  run_script "on run argv
	tell application id \"com.33to9.TinyRecorder\" to configure$params
end run" "${args[@]}" >/dev/null || exit 1
  [ $JSON = 1 ] && echo '{"ok":true}'
  return 0
}

show_settings() {
  if [ $JSON = 1 ]; then
    run_script 'tell application id "com.33to9.TinyRecorder" to diagnose json true' || exit 1
    echo
    return 0
  fi
  local out
  out=$(run_script 'tell application id "com.33to9.TinyRecorder" to diagnose') || exit 1
  printf '%s\n' "$out" | awk -F'\t' '$1 == "setting" { printf "%-22s %s\n", $3 ":", $4 }'
}

# Path of the TinyRecorder.app that contains this script (resolving symlinks), or nothing.
own_app() {
  local src=$0 t
  while [ -L "$src" ]; do
    t=$(readlink "$src")
    case $t in /*) src=$t ;; *) src=$(dirname "$src")/$t ;; esac
  done
  case $src in */Contents/Resources/tinyrecorder) printf '%s' "${src%/Contents/Resources/tinyrecorder}" ;; esac
}

# Checks that TinyRecorder can be driven from here: the app, this command on the PATH,
# permission to control the app, and the app's own checks (Screen Recording permission,
# save folder). Exit status 1 if anything is an error.
cmd_doctor() {
  [ $# = 0 ] || usage_error "doctor takes no arguments"
  local rows="" errors=0 app on_path out msg errfile TAB
  TAB=$(printf '\t')
  add_row() {
    rows="$rows$1$TAB$2$TAB$3
"
    [ "$1" != error ] || errors=$((errors + 1))
  }

  app=$(own_app)
  if [ -n "$app" ]; then add_row ok command "$0 (in $app)"; else add_row warning command "$0 is not inside TinyRecorder.app; it may be an old copy"; fi
  on_path=$(command -v tinyrecorder 2>/dev/null)
  if [ -n "$on_path" ]; then
    add_row ok path "tinyrecorder is on the PATH ($on_path)"
  else
    add_row warning path "tinyrecorder is not on the PATH. Choose TinyRecorder › Install Command-Line Tool…, then open a new Terminal window"
  fi
  if app_running; then add_row ok running "TinyRecorder is running"; else add_row ok running "TinyRecorder isn't running; it opens when a command needs it"; fi

  errfile=$(mktemp "${TMPDIR:-/tmp}/tinyrecorder.XXXXXX") || die "can't create a temporary file"
  if out=$(osascript -e 'tell application id "com.33to9.TinyRecorder" to diagnose' 2>"$errfile"); then
    add_row ok automation-permission "this terminal may control TinyRecorder"
    rows="$rows$(printf '%s\n' "$out" | awk -F'\t' '$1 == "check" { print $2 "\t" $3 "\t" $4 }')
"
    errors=$((errors + $(printf '%s\n' "$out" | awk -F'\t' '$1 == "check" && $2 == "error"' | wc -l)))
  else
    msg=$(cat "$errfile")
    case $msg in
      *-1743*) add_row error automation-permission "this terminal may not control TinyRecorder. Allow it in System Settings › Privacy & Security › Automation" ;;
      *-1728*|*-1708*) add_row error app-version "TinyRecorder is too old for doctor (1.8.26 or later). Update it with Check for Updates…" ;;
      *-600*|*-10814*|*-2700*) add_row error app "macOS can't find TinyRecorder. Install it from tinyrecorder.app" ;;
      *) add_row error app "couldn't ask TinyRecorder: ${msg#*execution error: }" ;;
    esac
  fi
  rm -f "$errfile"

  if [ $JSON = 1 ]; then
    local first=1 status name value
    printf '{"ok":%s,"checks":[' "$([ $errors = 0 ] && echo true || echo false)"
    while IFS="$TAB" read -r status name value; do
      [ -n "$status" ] || continue
      [ $first = 1 ] || printf ','
      first=0
      printf '{"status":%s,"name":%s,"value":%s}' "$(json_str "$status")" "$(json_str "$name")" "$(json_str "$value")"
    done <<ROWS
$rows
ROWS
    printf ']}\n'
  else
    printf '%s' "$rows" | awk -F'\t' 'NF { mark = ($1 == "ok") ? "ok  " : (($1 == "warning") ? "warn" : "FAIL"); printf "%s  %-28s %s\n", mark, $2, $3 }'
    if [ $errors = 0 ]; then echo "Everything needed is in place."; else echo "$errors problem(s) to fix (see FAIL above)."; fi
  fi
  [ $errors = 0 ]
}

cmd_frames() {
  local file=${1:-}; [ -n "$file" ] || usage_error "frames needs the path of a recording"
  shift
  local every="" count="" sheet=0 width="" output="" ms
  while [ $# -gt 0 ]; do
    case $1 in
      --every) [ $# -ge 2 ] || usage_error "--every needs a number of seconds"; every=$2; shift ;;
      --count) [ $# -ge 2 ] || usage_error "--count needs a number"; count=$2; shift ;;
      --sheet) sheet=1 ;;
      --width) [ $# -ge 2 ] || usage_error "--width needs a number of pixels"; width=$2; shift ;;
      --output|-o) [ $# -ge 2 ] || usage_error "--output needs a folder"; output=$2; shift ;;
      -*) usage_error "unknown option for frames: $1" ;;
      *) usage_error "unexpected argument: $1" ;;
    esac
    shift
  done
  [ -z "$every" ] || [ -z "$count" ] || usage_error "give --every or --count, not both"
  [ -z "$count" ] || check_number --count "$count"
  [ -z "$width" ] || check_number --width "$width"
  [ -f "$file" ] || die "no such file: $file"
  P=""; A=()
  add_param "from file" "$(abs_path "$file")"
  if [ -n "$every" ]; then
    case $every in *[!0-9.]*|.*|*.*.*) usage_error "--every must be a number of seconds, e.g. 2 or 0.5" ;; esac
    # Milliseconds as a whole number: "0.5" as real would depend on the decimal separator.
    ms=$(awk -v s="$every" 'BEGIN { printf "%d", s * 1000 + 0.5 }')
    [ "$ms" -gt 0 ] || usage_error "--every must be more than 0"
    A+=("$ms"); P="$P interval (((item ${#A[@]} of argv) as integer) / 1000)"
  fi
  [ -z "$count" ] || add_param "frame count" "$count" int
  [ -z "$width" ] || add_param "maximum width" "$width" int
  [ -z "$output" ] || add_param "saving to" "$(abs_path "$output")"
  [ $sheet = 0 ] || P="$P contact sheet true"
  [ $JSON = 0 ] || P="$P json true"
  local out
  out=$(run_script "on run argv
	with timeout of 600 seconds
		tell application id \"com.33to9.TinyRecorder\" to extract frames$P
	end timeout
end run" "${A[@]}") || exit 1
  if [ $JSON = 1 ]; then printf '{"files":%s}\n' "$out"; else printf '%s\n' "$out"; fi
}

cmd_version() {
  # This script lives in TinyRecorder.app/Contents/Resources (possibly behind a symlink).
  local src=$0 t plist version
  while [ -L "$src" ]; do
    t=$(readlink "$src")
    case $t in /*) src=$t ;; *) src=$(dirname "$src")/$t ;; esac
  done
  plist="$(dirname "$src")/../Info.plist"
  version=$(/usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' "$plist" 2>/dev/null) || version=unknown
  if [ $JSON = 1 ]; then printf '{"version":%s}\n' "$(json_str "$version")"; else echo "$version"; fi
}

# --json can go anywhere.
ARGS=()
for a in "$@"; do
  if [ "$a" = --json ]; then JSON=1; else ARGS+=("$a"); fi
done
set -- ${ARGS[@]+"${ARGS[@]}"}

[ "$(uname)" = Darwin ] || die "TinyRecorder runs on macOS only"

cmd=${1:-help}
[ $# -gt 0 ] && shift
case $cmd in
  record) cmd_record "$@" ;;
  stop) cmd_stop "$@" ;;
  list|ls) cmd_list "$@" ;;
  doctor) cmd_doctor "$@" ;;
  frames) cmd_frames "$@" ;;
  screenshot|shot) cmd_screenshot "$@" ;;
  pause) [ $# = 0 ] || usage_error "pause takes no arguments"; simple_command "pause recording" ;;
  resume) [ $# = 0 ] || usage_error "resume takes no arguments"; simple_command "resume recording" ;;
  discard) [ $# = 0 ] || usage_error "discard takes no arguments"; simple_command "discard recording" ;;
  status) [ $# = 0 ] || usage_error "status takes no arguments"; cmd_status ;;
  config|configure) cmd_config "$@" ;;
  version|--version|-v) cmd_version ;;
  help|--help|-h) usage ;;
  *) usage_error "unknown command: $cmd" ;;
esac
