<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE dictionary SYSTEM "file://localhost/System/Library/DTDs/sdef.dtd">
<dictionary title="TinyRecorder Scriptable">
    <suite name="TinyRecorder Scripting" code="QKrd" description="TinyRecorder commands">
        <command name="record screen" code="QKrdSlsn" description="Select screen to record">
            <cocoa class="selectScreen"/>
            <parameter name="client" code="CLnt" type="text" hidden="yes" optional="yes" description="Set by the tinyrecorder command">
                <cocoa key="client"/>
            </parameter>
            <parameter name="numbered" code="NUMb" type="integer" description="Screen number" optional="yes">
                <cocoa key="index"/>
            </parameter>
            <parameter name="countdown" code="CDwn" type="integer" description="Seconds to count down before recording starts, instead of the Delay Before Recording setting (0 = none)" optional="yes">
                <cocoa key="countdown"/>
            </parameter>
            <parameter name="showing preview" code="PRvw" type="boolean" description="false: no preview, trimmer or Recording Completed notification after this recording is saved" optional="yes">
                <cocoa key="preview"/>
            </parameter>
            <parameter name="saving to" code="OUtp" type="text" description="POSIX path to save the recording as. TinyRecorder adds the extension of the current format; the folder must exist" optional="yes">
                <cocoa key="output"/>
            </parameter>
        </command>
        
        <command name="record screen area" code="QKrdSlar" description="Select screen area to record">
            <cocoa class="selectArea"/>
            <parameter name="client" code="CLnt" type="text" hidden="yes" optional="yes" description="Set by the tinyrecorder command">
                <cocoa key="client"/>
            </parameter>
            <parameter name="rectangle" code="REct" type="text" description="The area as &quot;x,y,width,height&quot; in points from the display's top-left corner. Without it you drag the area with the mouse" optional="yes">
                <cocoa key="rect"/>
            </parameter>
            <parameter name="display number" code="DIar" type="integer" description="Display number for the rectangle (1 if omitted)" optional="yes">
                <cocoa key="display"/>
            </parameter>
            <parameter name="countdown" code="CDwn" type="integer" description="Seconds to count down before recording starts, instead of the Delay Before Recording setting (0 = none)" optional="yes">
                <cocoa key="countdown"/>
            </parameter>
            <parameter name="showing preview" code="PRvw" type="boolean" description="false: no preview, trimmer or Recording Completed notification after this recording is saved" optional="yes">
                <cocoa key="preview"/>
            </parameter>
            <parameter name="saving to" code="OUtp" type="text" description="POSIX path to save the recording as. TinyRecorder adds the extension of the current format; the folder must exist" optional="yes">
                <cocoa key="output"/>
            </parameter>
        </command>
        
        <command name="record application" code="QKrdSlap" description="Select apps to record">
            <cocoa class="selectApps"/>
            <parameter name="client" code="CLnt" type="text" hidden="yes" optional="yes" description="Set by the tinyrecorder command">
                <cocoa key="client"/>
            </parameter>
            <parameter name="named" code="NAmd" type="text" description="Application Name" optional="yes">
                <cocoa key="name"/>
            </parameter>
            <parameter name="countdown" code="CDwn" type="integer" description="Seconds to count down before recording starts, instead of the Delay Before Recording setting (0 = none)" optional="yes">
                <cocoa key="countdown"/>
            </parameter>
            <parameter name="showing preview" code="PRvw" type="boolean" description="false: no preview, trimmer or Recording Completed notification after this recording is saved" optional="yes">
                <cocoa key="preview"/>
            </parameter>
            <parameter name="saving to" code="OUtp" type="text" description="POSIX path to save the recording as. TinyRecorder adds the extension of the current format; the folder must exist" optional="yes">
                <cocoa key="output"/>
            </parameter>
        </command>
        
        <command name="record window" code="QKrdSlwd" description="Select windows to record">
            <cocoa class="selectWindows"/>
            <parameter name="client" code="CLnt" type="text" hidden="yes" optional="yes" description="Set by the tinyrecorder command">
                <cocoa key="client"/>
            </parameter>
            <parameter name="titled" code="TItd" type="text" description="Window Title" optional="yes">
                <cocoa key="title"/>
            </parameter>
            <parameter name="in application" code="APli" type="text" description="Application Name" optional="yes">
                <cocoa key="app"/>
            </parameter>
            <parameter name="identified by" code="WIid" type="integer" description="Window ID, as listed by list targets showing &quot;windows&quot;" optional="yes">
                <cocoa key="id"/>
            </parameter>
            <parameter name="countdown" code="CDwn" type="integer" description="Seconds to count down before recording starts, instead of the Delay Before Recording setting (0 = none)" optional="yes">
                <cocoa key="countdown"/>
            </parameter>
            <parameter name="showing preview" code="PRvw" type="boolean" description="false: no preview, trimmer or Recording Completed notification after this recording is saved" optional="yes">
                <cocoa key="preview"/>
            </parameter>
            <parameter name="saving to" code="OUtp" type="text" description="POSIX path to save the recording as. TinyRecorder adds the extension of the current format; the folder must exist" optional="yes">
                <cocoa key="output"/>
            </parameter>
        </command>
        
        <command name="record system audio" code="QKrdREad" description="Record system audio">
            <cocoa class="recordAudio"/>
            <parameter name="client" code="CLnt" type="text" hidden="yes" optional="yes" description="Set by the tinyrecorder command">
                <cocoa key="client"/>
            </parameter>
            <parameter name="microphone" code="MIcp" type="boolean" description="Whether to record the microphone at the same time" optional="yes">
                <cocoa key="mic"/>
            </parameter>
            <parameter name="showing preview" code="PRvw" type="boolean" description="false: no preview, trimmer or Recording Completed notification after this recording is saved" optional="yes">
                <cocoa key="preview"/>
            </parameter>
            <parameter name="saving to" code="OUtp" type="text" description="POSIX path to save the recording as. TinyRecorder adds the extension of the current format; the folder must exist" optional="yes">
                <cocoa key="output"/>
            </parameter>
        </command>
        
        <command name="stop recording" code="QKrdSTop" description="Stop the current recording and save it">
            <cocoa class="stopRecordingCommand"/>
            <parameter name="waiting until saved" code="WAsv" type="boolean" description="Wait until the file is saved (and its audio mixed or converted), then return its path. Raises an error if saving fails. Without it the command returns right away." optional="yes">
                <cocoa key="wait"/>
            </parameter>
            <result type="text" description="With waiting until saved: the POSIX path of the saved file"/>
        </command>

        <record-type name="recording info" code="QKri" description="What TinyRecorder is doing">
            <property name="state" code="QKst" type="text" description="idle, countdown, starting, recording or paused">
                <cocoa key="state"/>
            </property>
            <property name="recording kind" code="QKkd" type="text" description="screen, window, windows, application, screenarea, systemaudio or idevice (only while recording)">
                <cocoa key="kind"/>
            </property>
            <property name="elapsed" code="QKel" type="real" description="Seconds recorded so far, not counting pauses (only while recording)">
                <cocoa key="elapsed"/>
            </property>
        </record-type>

        <command name="recording status" code="QKrdSTat" description="Tell whether TinyRecorder is recording">
            <cocoa class="recordingStatusCommand"/>
            <result type="recording info"/>
        </command>

        <command name="pause recording" code="QKrdPAus" description="Pause the current recording">
            <cocoa class="pauseRecordingCommand"/>
        </command>

        <command name="resume recording" code="QKrdREsm" description="Resume a paused recording">
            <cocoa class="resumeRecordingCommand"/>
        </command>

        <command name="discard recording" code="QKrdDIsc" description="Stop the current recording and move it to the Trash">
            <cocoa class="discardRecordingCommand"/>
        </command>

        <command name="list targets" code="QKrdLIst" description="List the displays, windows or apps that can be recorded">
            <cocoa class="listTargetsCommand"/>
            <parameter name="showing" code="KInd" type="text" description="displays, windows or apps (displays if omitted)" optional="yes">
                <cocoa key="kind"/>
            </parameter>
            <parameter name="in application" code="APli" type="text" description="Only the windows of this app" optional="yes">
                <cocoa key="app"/>
            </parameter>
            <parameter name="json" code="JSon" type="boolean" description="Return JSON instead of tab-separated lines with a header" optional="yes">
                <cocoa key="json"/>
            </parameter>
            <result type="text" description="One line per target, or a JSON array"/>
        </command>

        <command name="take screenshot" code="QKrdSHot" description="Save a screenshot of a display, a window or an area and return its path (macOS 14 or later)">
            <cocoa class="takeScreenshotCommand"/>
            <parameter name="display number" code="DIar" type="integer" description="Display number (1 if no window is given)" optional="yes">
                <cocoa key="display"/>
            </parameter>
            <parameter name="window titled" code="SHtt" type="text" description="Exact window title" optional="yes">
                <cocoa key="title"/>
            </parameter>
            <parameter name="in application" code="APli" type="text" description="Application of the window" optional="yes">
                <cocoa key="app"/>
            </parameter>
            <parameter name="window identified by" code="SHid" type="integer" description="Window ID, as listed by list targets" optional="yes">
                <cocoa key="id"/>
            </parameter>
            <parameter name="rectangle" code="REct" type="text" description="Only this area of the display: &quot;x,y,width,height&quot; in points from its top-left corner" optional="yes">
                <cocoa key="rect"/>
            </parameter>
            <parameter name="saving to" code="OUtp" type="text" description="POSIX path of the image (.png, .jpg). Without it, it goes to the recordings folder" optional="yes">
                <cocoa key="output"/>
            </parameter>
            <result type="text" description="POSIX path of the saved image"/>
        </command>

        <command name="diagnose" code="QKrdDIag" description="Check what TinyRecorder needs to work (permissions, save folder) and list its settings">
            <cocoa class="diagnoseCommand"/>
            <parameter name="json" code="JSon" type="boolean" description="Return JSON instead of tab-separated lines (kind, status, name, value)" optional="yes">
                <cocoa key="json"/>
            </parameter>
            <result type="text" description="One line per check or setting, or a JSON array"/>
        </command>

        <command name="extract frames" code="QKrdFRam" description="Save still images from a recording, so its content can be checked without playing it">
            <cocoa class="extractFramesCommand"/>
            <parameter name="from file" code="FIle" type="text" description="POSIX path of the video">
                <cocoa key="file"/>
            </parameter>
            <parameter name="interval" code="INtv" type="real" description="One frame every this many seconds" optional="yes">
                <cocoa key="interval"/>
            </parameter>
            <parameter name="frame count" code="FRct" type="integer" description="This many frames, evenly spread (8 if neither this nor interval is given; 12 for a contact sheet)" optional="yes">
                <cocoa key="count"/>
            </parameter>
            <parameter name="contact sheet" code="SHet" type="boolean" description="Save all frames in one image, each with its time" optional="yes">
                <cocoa key="sheet"/>
            </parameter>
            <parameter name="maximum width" code="MXwd" type="integer" description="Largest width of each frame in pixels (1280; 480 on a contact sheet)" optional="yes">
                <cocoa key="width"/>
            </parameter>
            <parameter name="saving to" code="OUtp" type="text" description="POSIX path of the folder for the images (default: a &quot;NAME frames&quot; folder next to the video)" optional="yes">
                <cocoa key="output"/>
            </parameter>
            <parameter name="json" code="JSon" type="boolean" description="Return a JSON array instead of one path per line" optional="yes">
                <cocoa key="json"/>
            </parameter>
            <result type="text" description="Paths of the saved images"/>
        </command>

        <command name="configure" code="QKrdSEtt" description="Modify recording settings">
            <cocoa class="setPreferences"/>
            <parameter name="hires" code="REsl" type="boolean" description="Recording in Retina resolution" optional="yes">
                <cocoa key="hires"/>
            </parameter>
            <parameter name="fps" code="FPss" type="integer" description="Set the recording frame rate" optional="yes">
                <cocoa key="fps"/>
            </parameter>
            <parameter name="quality" code="QLty" type="integer" description="Video quality (3=high, 2=medium, 1=low)" optional="yes">
                <cocoa key="quality"/>
            </parameter>
            <parameter name="cursor" code="MOus" type="boolean" description="Whether to record the cursor" optional="yes">
                <cocoa key="cursor"/>
            </parameter>
            <parameter name="sound" code="SUnd" type="boolean" description="Whether to record the system sound" optional="yes">
                <cocoa key="sound"/>
            </parameter>
            <parameter name="microphone" code="MIce" type="boolean" description="Whether to record the microphone" optional="yes">
                <cocoa key="microphone"/>
            </parameter>
            <parameter name="mic device" code="MCNa" type="text" description="The name of the audio input device (default is 'default')" optional="yes">
                <cocoa key="micname"/>
            </parameter>
            <parameter name="hdr" code="HDri" type="boolean" description="Whether to record in HDR mode (macOS 15 or later only)" optional="yes">
                <cocoa key="hdr"/>
            </parameter>
            <parameter name="save folder" code="SVfd" type="text" description="POSIX path of the folder recordings are saved to" optional="yes">
                <cocoa key="folder"/>
            </parameter>
            <parameter name="file format" code="VFmt" type="text" description="Video file format: mp4 or mov" optional="yes">
                <cocoa key="format"/>
            </parameter>
            <parameter name="video codec" code="VCdc" type="text" description="Video codec: h264 or h265" optional="yes">
                <cocoa key="codec"/>
            </parameter>
            <parameter name="countdown" code="CDwn" type="integer" description="Delay Before Recording, in seconds (0 to 99)" optional="yes">
                <cocoa key="countdown"/>
            </parameter>
            <parameter name="show preview" code="SPrv" type="boolean" description="Show the preview thumbnail after a recording is saved" optional="yes">
                <cocoa key="preview"/>
            </parameter>
        </command>
    </suite>
</dictionary>
